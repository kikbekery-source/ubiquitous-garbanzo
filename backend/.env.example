# Google Drive API
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Gemini AI (ใช้สำหรับ AI Consultant)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Marketing API
FB_APP_ID=your_fb_app_id_here
FB_APP_SECRET=your_fb_app_secret_here
FB_ACCESS_TOKEN=your_fb_access_token_here
FB_AD_ACCOUNT_ID=your_fb_ad_account_id_here
FB_PAGE_ID=your_fb_page_id_here

# TikTok Business API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id_here
TIKTOK_BUSINESS_ID=your_tiktok_business_id_here

# Server
PORT=3001

# Database
DB_PATH=./data/footage.db
